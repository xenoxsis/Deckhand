<!--
    No StartupUri: which window comes up depends on the mode chosen at startup, so
    App.OnStartup builds it by hand. See App.xaml.cs.
-->
<Application x:Class="Deckhand.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Deckhand">
    <Application.Resources>

        <!-- Touch-friendly button: big hit target, never focusable -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinHeight" Value="{x:Static local:TileMetrics.MinHeight}"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Margin" Value="{x:Static local:TileMetrics.TileMargin}"/>
            <Setter Property="FontSize" Value="{x:Static local:TileMetrics.FontSize}"/>
            <Setter Property="Foreground" Value="{x:Static local:TileMetrics.Text}"/>
            <Setter Property="Background" Value="{x:Static local:TileMetrics.Tile}"/>
            <Setter Property="BorderBrush" Value="{x:Static local:TileMetrics.Line}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{x:Static local:TileMetrics.Border}" CornerRadius="{x:Static local:TileMetrics.Corner}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{x:Static local:TileMetrics.LabelPadding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{x:Static local:TileMetrics.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{x:Static local:TileMetrics.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The two halves of a split tile: one button to look at, two to tap. An app
            tile launches on the wide side and picks a window on the narrow one, and
            reading as a single control is the point — so the pair shares one rounded
            outline and the only thing between them is the left half's right border.

            They are separate styles rather than one with overrides because the corner
            radius and border thickness live inside the template, where a Setter can't
            reach them. Everything else is TileButton's.
        -->
        <Style x:Key="SplitTileLeft" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Margin" Value="{x:Static local:TileMetrics.SplitLeftMargin}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- The right border is the divider line for the whole pair. -->
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{x:Static local:TileMetrics.Border}" CornerRadius="{x:Static local:TileMetrics.SplitLeftCorner}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{x:Static local:TileMetrics.LabelPadding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{x:Static local:TileMetrics.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{x:Static local:TileMetrics.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SplitTileRight" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Margin" Value="{x:Static local:TileMetrics.SplitRightMargin}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- No left border: the half on the left already drew it. -->
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{x:Static local:TileMetrics.SplitRightBorder}" CornerRadius="{x:Static local:TileMetrics.SplitRightCorner}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{x:Static local:TileMetrics.NarrowLabelPadding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{x:Static local:TileMetrics.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square button for the top bar -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{x:Static local:TileMetrics.Dim}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="8,4,8,4"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- The box around one section, so its slice of the grid is visible -->
        <Style x:Key="SectionGroup" TargetType="Border">
            <Setter Property="Background" Value="{x:Static local:TileMetrics.Group}"/>
            <Setter Property="BorderBrush" Value="{x:Static local:TileMetrics.Line}"/>
            <Setter Property="BorderThickness" Value="{x:Static local:TileMetrics.Border}"/>
            <Setter Property="CornerRadius" Value="{x:Static local:TileMetrics.GroupCorner}"/>
            <Setter Property="Margin" Value="{x:Static local:TileMetrics.TileMargin}"/>
            <Setter Property="Padding" Value="2,2,2,4"/>
        </Style>

        <!--
            A dark drop-down menu, used by the tray icon behind a right-click on it and by
            the designer's FOCUSED button. Named for what it is rather than for the first
            thing that wanted it: both are a plain list of one-line commands.

            Templated rather than styled, both of them. The stock MenuItem paints its own
            highlight from a trigger inside its template, which no Setter out here can
            reach, so a plain style produces a dark menu with a light blue hover in it; and
            the stock ContextMenu keeps a lighter gutter down the left for icons and
            checkmarks that nothing here has. Neither template needs to do more than these
            menus actually use: one line of content, no submenus, no icons.
        -->
        <Style x:Key="DarkMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{x:Static local:TileMetrics.Group}"/>
            <Setter Property="BorderBrush" Value="{x:Static local:TileMetrics.Line}"/>
            <Setter Property="BorderThickness" Value="{x:Static local:TileMetrics.Border}"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="Foreground" Value="{x:Static local:TileMetrics.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{x:Static local:TileMetrics.Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#37373D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Applied to the Separator by name: a menu otherwise styles its own separators
             from the theme, and that one is a light line. -->
        <Style x:Key="DarkMenuLine" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{x:Static local:TileMetrics.Line}" Margin="0,5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Groups have a fixed size, so overflowing tiles are reached by scrolling
            inside the group. The default scrollbar is too thin to hit with a finger
            and too bright for this palette, hence the replacement: no arrow buttons,
            a wide track, and a thumb that can't shrink below a tappable height.
        -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="14"/>
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="Background" Value="{x:Static local:TileMetrics.Background}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Focusable="False" Opacity="0"
                                                  Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Focusable="False" Opacity="0"
                                                  Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False" MinHeight="32">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#5A5A60" CornerRadius="4"
                                                        Margin="3,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
